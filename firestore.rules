rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /players/{uid} {
      allow read, write: if owns(uid);

      match /marketLab/{documentId} {
        allow read, write: if owns(uid);
      }
    }
  }
}
